# Скопируйте в .env и при необходимости измените значения.
# Затем: ./scripts/setup-pushhive.sh && docker compose up --build -d && ./scripts/seed-pushhive.sh

PUBLIC_APP_URL=http://localhost:8000
PUSHHIVE_URL=http://pushhive:3000
# Browser-facing PushHive URL. HTTPS-профиль: https://pwa.lan/ph ; local: http://localhost/ph
PUSHHIVE_PUBLIC_URL=http://localhost:3000
PUSHHIVE_API_KEY=
DATABASE_PATH=data/app.db
ACK_SECRET=
FRONTEND_DIR=../frontend

# TLS / публичный режим (один домен; PushHive на /ph)
PUBLIC_APP_HOST=

# PushHive (используются контейнерами pushhive / pushhive-worker)
PORT=3000
MONGODB_URI=mongodb://pushhive-mongo:27017/pushhive
SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com
NODE_ENV=production
REDIS_HOST=pushhive-redis
REDIS_PORT=6379
WORKER_CONCURRENCY=10
WORKER_RATE_LIMIT=50

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin
PUSHHIVE_SITE_NAME="PWA Messenger"
PUSHHIVE_SITE_DOMAIN=localhost:8000
