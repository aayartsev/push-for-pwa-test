# Публичный сервер: один домен, Let's Encrypt, PushHive на /ph.
# Задайте PUBLIC_APP_HOST в .env
# Запуск: docker compose -f docker-compose.yml -f docker-compose.public.yml up --build -d

{$PUBLIC_APP_HOST} {
	handle_path /ph/* {
		reverse_proxy pushhive:3000
	}

	handle {
		reverse_proxy app:8000
	}
}
